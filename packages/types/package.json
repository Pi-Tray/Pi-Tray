{
    "name": "@pi-tray/types",
    "version": "0.5.1",
    "description": "Types shared by Pi-Tray's server, editor, client and plugins",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prepack": "pnpm run build:dist",
        "build:dist": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type: 'module'}))\""
    },
    "devDependencies": {
        "typescript": "catalog:"
    },
    "publishConfig": {
        "main": "./dist/cjs/index.js",
        "types": "./dist/cjs/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/cjs/index.d.ts",
                "import": "./dist/esm/index.js",
                "require": "./dist/cjs/index.js"
            }
        }
    }
}
