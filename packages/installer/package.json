{
    "name": "@pi-tray/installer",
    "version": "0.0.0",
    "private": true,
    "description": "Installs, removes and lists plugin packages in the plugin dir.",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./read": "./src/read.ts"
    },
    "typesVersions": {
        "*": {
            "read": [
                "./src/read.ts"
            ]
        }
    },
    "files": [
        "src"
    ],
    "dependencies": {
        "@pi-tray/package-spec": "workspace:*",
        "@pi-tray/paths": "workspace:*",
        "tar": "^7.4.3",
        "semver": "^7.8.5"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "@types/semver": "^7.8.0"
    }
}
