#!/bin/bash
# Installs a newer Pi-Tray client from the Pi-Tray server, if it offers one signed by a trusted key.
#
# Usage: pi-tray-update [--force]    check the server and install its client if it's newer
#        pi-tray-update --retry      the same, but first forgets which client failed to start, see below
#        pi-tray-update --rollback   go back to the client that was installed before the current one
#        pi-tray-update --verify     run by pi-tray-update-verify.service after an install, see below
#
# --force installs the server's client even if it isn't newer, or one that failed to start before, for testing.
# It never skips the signature checks.
#
# Exits 3 when the server's client is the one that failed to start last time, so it wasn't installed.
#
# Each client lives in /opt/pi-tray/releases/<built_at>-<version>, and /opt/pi-tray/client is a symlink to the current
# one, which the kiosk opens. The page asks for a check through pi-tray-update-trigger, and reloads itself after one.
#
# After an install, pi-tray-update-verify.service watches the kiosk's console log. Once the page reloads, or the kiosk
# restarts, the new client has a few minutes to log in to the server and log "pi-tray client ready <version>". If it
# doesn't, the previous client is put back, the kiosk restarted, and that release isn't installed again until --retry,
# which the editor's devices page can ask for through the client, or --force.
#
# Trust comes from /var/lib/pi-tray-updater/allowed_signers, in OpenSSH's allowed signers format, starting "# serial N".
# The server's copy replaces it when the recovery key signed it and its serial is higher, which is how keys are rotated.

set -euo pipefail

RELEASE_NAMESPACE="client-update@pi-tray.ollieg.codes"
KEYS_NAMESPACE="trusted-keys@pi-tray.ollieg.codes"

# overridable for testing, never set in normal use
state_dir="${PI_TRAY_UPDATER_STATE_DIR:-/var/lib/pi-tray-updater}"
install_dir="${PI_TRAY_INSTALL_DIR:-/opt/pi-tray}"
server_file="${PI_TRAY_SERVER_FILE:-/boot/firmware/pi-tray.txt}"
console_log="${PI_TRAY_CONSOLE_LOG:-/var/log/pi-tray/console.log}"
systemctl_command="${PI_TRAY_SYSTEMCTL:-systemctl}"

releases_dir="$install_dir/releases"
current_link="$install_dir/client"
trusted_keys="$state_dir/allowed_signers"

# what the verify step is waiting on, and the release that failed it last
pending_file="$state_dir/pending"
rejected_file="$state_dir/rejected"

SMALL_FILE_LIMIT=65536
ARCHIVE_LIMIT=$((64 * 1024 * 1024))
FETCH_SECONDS=30
ARCHIVE_FETCH_SECONDS=300

# how long a new client has to log in once it's loaded. generous, as the server has only just been reached
READY_SECONDS=180

log() {
    echo "pi-tray-update: $*"
}

fail() {
    echo "pi-tray-update: $*" >&2
    exit 1
}

force=no
retry=no
mode=update
for argument in "$@"; do
    case "$argument" in
        --force) force=yes ;;
        --retry) retry=yes ;;
        --rollback) mode=rollback ;;
        --verify) mode=verify ;;
        *) fail "unknown option $argument, expected --force, --retry, --rollback or --verify" ;;
    esac
done

[ "$(id -u)" = 0 ] || [ -n "${PI_TRAY_UPDATER_STATE_DIR:-}" ] || fail "run as root"
[ -f "$trusted_keys" ] || fail "$trusted_keys is missing, so no update can be trusted"
if [ -e "$current_link" ] && [ ! -L "$current_link" ]; then
    fail "$current_link is a folder rather than a link to a release, move it into $releases_dir first"
fi
mkdir -p "$releases_dir"

# one run at a time, a trigger while one is running has nothing to add. that includes a verify, so nothing new is
# installed while the last install is still being checked.
# verify waits instead, as it's started by the install that's still holding the lock
exec 9> "$state_dir/lock"
if [ "$mode" = verify ]; then
    flock 9
elif ! flock -n 9; then
    log "another update check is already running, or the last install is still being verified"
    exit 0
fi

current_release() {
    local target
    target=$(readlink "$current_link" 2>/dev/null) || return 0
    basename "$target"
}

# the release folder name starts with its built_at, 0 for one that didn't come from a signed update
built_at_of() {
    local built_at="${1%%-*}"
    [[ "$built_at" =~ ^[0-9]+$ ]] && echo "$built_at" || echo 0
}

# swaps the client symlink in one step, so the kiosk never sees it missing
point_client_at() {
    local release_name="$1"
    local previous
    previous=$(current_release)

    ln -sfn "releases/$release_name" "$current_link.new"
    mv -T "$current_link.new" "$current_link"

    if [ -n "$previous" ] && [ "$previous" != "$release_name" ]; then
        echo "$previous" > "$state_dir/previous"
    fi

    log "client is now $release_name"
}

if [ "$mode" = rollback ]; then
    previous=$(cat "$state_dir/previous" 2>/dev/null || true)
    if [ -z "$previous" ] || [ ! -d "$releases_dir/$previous" ]; then
        fail "there's no previous client to go back to"
    fi

    # a manual rollback means whatever was being verified is no longer installed
    rm -f "$pending_file"
    point_client_at "$previous"
    exit 0
fi

# --- verify: did the new client start? ---

if [ "$mode" = verify ]; then
    if [ ! -f "$pending_file" ]; then
        log "no install is waiting to be verified"
        exit 0
    fi

    # written by the install as: release, release it replaced, console log inode, console log size at the time
    mapfile -t pending_fields < "$pending_file"
    if [ "${#pending_fields[@]}" -ne 4 ] || [[ ! "${pending_fields[3]}" =~ ^[0-9]+$ ]]; then
        log "the pending install record is damaged, so it can't be verified"
        rm -f "$pending_file"
        exit 0
    fi

    pending_release="${pending_fields[0]}"
    pending_previous="${pending_fields[1]}"
    log_inode="${pending_fields[2]}"
    log_offset="${pending_fields[3]}"

    if [ "$(current_release)" != "$pending_release" ]; then
        log "$pending_release is no longer the installed client, nothing to verify"
        rm -f "$pending_file"
        exit 0
    fi

    pending_version="${pending_release#*-}"
    # chromium quotes the message, so 0.3.0 can't match 0.3.0-beta.1
    ready_line="\"pi-tray client ready $pending_version\""
    deadline=""

    # byte offsets, not characters
    export LC_ALL=C

    log "waiting for the kiosk to load $pending_release"

    while :; do
        current_inode=$(stat -c %i "$console_log" 2>/dev/null || echo none)
        current_size=$(stat -c %s "$console_log" 2>/dev/null || echo 0)

        # .xinitrc moves the log aside when it gets big, so start the new one from the top
        if [ "$current_inode" != "$log_inode" ] || [ "$current_size" -lt "$log_offset" ]; then
            log_inode="$current_inode"
            log_offset=0
        fi

        if [ "$current_size" -gt "$log_offset" ]; then
            new_text=$(tail -c +"$((log_offset + 1))" "$console_log" | head -c "$((current_size - log_offset))"; echo x)
            new_text="${new_text%x}"

            # only whole lines, the rest is read next time once it's finished
            if [[ "$new_text" == *$'\n'* ]]; then
                whole_lines="${new_text%$'\n'*}"$'\n'
                log_offset=$((log_offset + ${#whole_lines}))

                if [ -z "$deadline" ] && grep -qF -e "pi-tray client reloading" -e "pi-tray kiosk starting" <<< "$whole_lines"; then
                    deadline=$(($(date +%s) + READY_SECONDS))
                    log "the kiosk is loading $pending_release, it has $READY_SECONDS seconds to log in"
                fi

                # only counts once loading started, as a line from before the reload came from the previous client
                if [ -n "$deadline" ] && grep -qF -e "$ready_line" <<< "$whole_lines"; then
                    log "$pending_release started and logged in"
                    rm -f "$pending_file"
                    if [ "$(cat "$rejected_file" 2>/dev/null)" = "$pending_release" ]; then
                        rm -f "$rejected_file"
                    fi
                    exit 0
                fi
            fi
        fi

        if [ -n "$deadline" ] && [ "$(date +%s)" -ge "$deadline" ]; then
            break
        fi

        sleep 1
    done

    log "$pending_release didn't log in within $READY_SECONDS seconds, going back to $pending_previous"

    echo "$pending_release" > "$rejected_file"
    rm -f "$pending_file"

    if [ -n "$pending_previous" ] && [ -d "$releases_dir/$pending_previous" ]; then
        point_client_at "$pending_previous"
    else
        fail "$pending_previous isn't there to go back to, so the kiosk stays on $pending_release"
    fi

    # the broken client is gone, so a manual --rollback can't land on it
    rm -rf "${releases_dir:?}/$pending_release"
    rm -f "$state_dir/previous"

    "$systemctl_command" restart pi-tray-kiosk.service || log "couldn't restart the kiosk, it'll load $pending_previous next time it starts"
    exit 1
fi

if [ "$retry" = yes ] && [ -f "$rejected_file" ]; then
    log "giving $(cat "$rejected_file") another chance to start"
    rm -f "$rejected_file"
fi

# --- where the server is ---

# the same parsing as the kiosk's .xinitrc: a byte order mark, comments, blank lines and carriage returns are ignored
server_url=$(sed '1s/^\xEF\xBB\xBF//' "$server_file" 2>/dev/null | grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*\r\?$' | head -n 1 | tr -d '\r[:space:]')
case "$server_url" in
    ws://*) server_base="http://${server_url#ws://}" ;;
    wss://*) server_base="https://${server_url#wss://}" ;;
    *) fail "$server_file doesn't hold a ws:// or wss:// address" ;;
esac
update_url="${server_base%/}/client-update"

work_dir=$(mktemp -d "$state_dir/check.XXXXXX")
staging_dir=""
cleanup() {
    rm -rf "$work_dir"
    if [ -n "$staging_dir" ]; then
        rm -rf "$staging_dir"
    fi
}
trap cleanup EXIT

fetch() {
    local file_name="$1" limit="$2" seconds="$3"
    curl --fail --silent --show-error --max-filesize "$limit" --max-time "$seconds" --output "$work_dir/$file_name" "$update_url/$file_name"
}

# a 404 means the server has nothing to offer, anything else that fails means it couldn't be reached
manifest_status=$(curl --silent --max-filesize "$SMALL_FILE_LIMIT" --max-time "$FETCH_SECONDS" --output "$work_dir/client-manifest.txt" \
    --write-out '%{http_code}' "$update_url/client-manifest.txt" || true)

case "$manifest_status" in
    200) ;;
    404)
        log "the server has no client update to offer"
        exit 0
        ;;
    000)
        # e.g. the PC is off, the next trigger tries again
        log "couldn't reach the server at $server_base"
        exit 0
        ;;
    *) fail "the server answered $manifest_status for the client manifest" ;;
esac

for file_name in client-manifest.txt.sig allowed_signers allowed_signers.sig; do
    fetch "$file_name" "$SMALL_FILE_LIMIT" "$FETCH_SECONDS" || fail "couldn't download $file_name from $update_url"
done

# --- trusted keys: take the server's list if the recovery key signed it and it's newer ---

serial_of() {
    sed -n '1s/^# serial \([0-9]\{1,9\}\)$/\1/p' "$1"
}

current_serial=$(serial_of "$trusted_keys")
offered_serial=$(serial_of "$work_dir/allowed_signers")
[ -n "$current_serial" ] || fail "$trusted_keys doesn't start with '# serial N'"

if [ -n "$offered_serial" ] && [ "$offered_serial" -gt "$current_serial" ]; then
    if ssh-keygen -Y verify -f "$trusted_keys" -I recovery -n "$KEYS_NAMESPACE" -s "$work_dir/allowed_signers.sig" < "$work_dir/allowed_signers" > /dev/null 2>&1; then
        install -m 600 "$work_dir/allowed_signers" "$trusted_keys.new"
        mv -T "$trusted_keys.new" "$trusted_keys"
        log "trusted keys updated to serial $offered_serial"
    else
        fail "the server's trusted keys (serial $offered_serial) aren't signed by the recovery key, so they were ignored"
    fi
fi

# --- the manifest: signed by the release key, then read strictly ---

if ! ssh-keygen -Y verify -f "$trusted_keys" -I release -n "$RELEASE_NAMESPACE" -s "$work_dir/client-manifest.txt.sig" < "$work_dir/client-manifest.txt" > /dev/null 2>&1; then
    fail "the client update isn't signed by the release key, so it wasn't installed"
fi

declare -A manifest=()
while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    [[ "$line" == *=* ]] || fail "the manifest has a line that isn't key=value"

    key="${line%%=*}"
    value="${line#*=}"

    case "$key" in
        version|built_at|sha256|size) ;;
        *) fail "the manifest has an unknown key '$key'" ;;
    esac

    [ -z "${manifest[$key]+set}" ] || fail "the manifest has '$key' twice"
    manifest[$key]="$value"
done < "$work_dir/client-manifest.txt"

version="${manifest[version]:-}"
built_at="${manifest[built_at]:-}"
sha256="${manifest[sha256]:-}"
size="${manifest[size]:-}"

# the version and built_at name a folder, so neither can hold a / or ..
if [[ ! "$version" =~ ^[0-9A-Za-z][0-9A-Za-z.+-]*$ ]] || [[ "$version" == *..* ]]; then
    fail "the manifest's version isn't valid"
fi
[[ "$built_at" =~ ^[0-9]{1,12}$ ]] || fail "the manifest's built_at isn't a number"
[[ "$sha256" =~ ^[0-9a-f]{64}$ ]] || fail "the manifest's sha256 isn't valid"
if [[ ! "$size" =~ ^[0-9]{1,10}$ ]] || [ "$size" -gt "$ARCHIVE_LIMIT" ]; then
    fail "the manifest's size isn't valid"
fi

release_name="$built_at-$version"
current=$(current_release)

if [ "$release_name" = "$current" ]; then
    log "$release_name is already installed"
    exit 0
fi

if [ "$force" = no ] && [ "$built_at" -le "$(built_at_of "$current")" ]; then
    log "$release_name isn't newer than ${current:-the installed client}"
    exit 0
fi

if [ "$force" = no ] && [ "$(cat "$rejected_file" 2>/dev/null)" = "$release_name" ]; then
    log "$release_name failed to start last time, so it won't be installed again until it's retried or the server offers a newer one"
    exit 3
fi

# --- the archive: exactly what the manifest says, holding only files and folders ---

fetch client.tgz "$ARCHIVE_LIMIT" "$ARCHIVE_FETCH_SECONDS" || fail "couldn't download client.tgz"

[ "$(stat -c %s "$work_dir/client.tgz")" = "$size" ] || fail "client.tgz isn't the size the manifest says"
[ "$(sha256sum "$work_dir/client.tgz" | cut -d' ' -f1)" = "$sha256" ] || fail "client.tgz doesn't match the manifest's sha256"

# signed, so only a bad release could break these, but a root process extracting into /opt checks anyway
if tar -tvzf "$work_dir/client.tgz" | grep -qv '^[-d]'; then
    fail "client.tgz holds something other than files and folders"
fi
if tar -tzf "$work_dir/client.tgz" | grep -qE '^/|(^|/)\.\.(/|$)'; then
    fail "client.tgz has a path outside its own folder"
fi
tar -tzf "$work_dir/client.tgz" | grep -qx 'index.html' || fail "client.tgz has no index.html"

staging_dir="$releases_dir/.staging-$release_name"
rm -rf "$staging_dir"
mkdir -p "$staging_dir"

tar -xzf "$work_dir/client.tgz" -C "$staging_dir" --no-same-owner --no-same-permissions

chown -R root:root "$staging_dir" 2>/dev/null || true
chmod -R u=rwX,go=rX "$staging_dir"

# a leftover copy of this release, e.g. from before a rollback, is replaced by the freshly checked one
rm -rf "${releases_dir:?}/$release_name"
mv -T "$staging_dir" "$releases_dir/$release_name"
staging_dir=""

# recorded before the swap, so the verify can't miss the page reloading however quickly it happens
{
    echo "$release_name"
    current_release
    stat -c %i "$console_log" 2>/dev/null || echo none
    stat -c %s "$console_log" 2>/dev/null || echo 0
} > "$pending_file"

point_client_at "$release_name"

# --- keep the current and previous clients, so there's always one to roll back to ---

previous=$(cat "$state_dir/previous" 2>/dev/null || true)
for release_path in "$releases_dir"/*; do
    [ -d "$release_path" ] || continue
    name=$(basename "$release_path")

    if [ "$name" != "$release_name" ] && [ "$name" != "$previous" ]; then
        rm -rf "$release_path"
        log "removed old client $name"
    fi
done

log "installed client $version"

# waits for this run to finish, as it needs the lock
"$systemctl_command" start --no-block pi-tray-update-verify.service || log "couldn't start the verify, so $release_name won't be rolled back if it fails to start"
