{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "opener:default",
    "deep-link:default",
    "fs:default",
    {
      "identifier": "fs:write-all",
      "allow": [
        {
          "path": "$DATA/pi-tray/**/*"
        }
      ]
    },
    {
      "identifier": "fs:read-all",
      "allow": [
        {
          "path": "$DATA/pi-tray/**/*"
        }
      ]
    },
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/pi-tray",
          "args": true,
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/pi-tray",
          "args": true,
          "sidecar": true
        }
      ]
    },
    "shell:allow-kill",
    "os:default"
  ]
}