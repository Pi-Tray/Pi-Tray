{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi-Tray",
  "version": "../../../package.json",
  "identifier": "codes.ollieg.pi-tray.editor",
  "build": {
    "beforeDevCommand": "node ../../scripts/stop-dev-cli.mjs && pnpm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build && node ../../scripts/ensure-cli-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pi-Tray Editor",
        "width": 1000,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pi-tray"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pi-tray-editor"]
      }
    }
  }
}
