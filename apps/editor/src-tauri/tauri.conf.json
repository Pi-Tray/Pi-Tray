{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi-Tray",
  "version": "../../../package.json",
  "identifier": "codes.ollieg.pi-tray.editor",
  "build": {
    "beforeDevCommand": "node ../../scripts/stop-dev-cli.mjs && node ../../scripts/ensure-client-update-dir.mjs && pnpm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build && node ../../scripts/ensure-cli-sidecar.mjs && node ../../scripts/pack-client-update.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pi-Tray Editor",
        "width": 1000,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pi-tray"
    ],
    "resources": {
      "client-update/": "client-update/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pi-tray-editor"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1QTNDNDAyRkUxRDQ1MjkKUldRcFJSMytBc1NqMWJjV1NIMmNTd2NpMFp5Ni9KcmhaYWFLUmd3NXFGd3dON2FCYzRwQVA0VXAK",
      "endpoints": ["https://github.com/Pi-Tray/Pi-Tray/releases/download/editor-latest/latest.json"],
      "requireSignedVersion": true
    }
  }
}