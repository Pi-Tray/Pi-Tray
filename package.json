{
    "name": "pi-tray",
    "private": true,
    "version": "0.6.0",
    "scripts": {
        "build": "pnpm -r build",
        "dev": "pnpm -r --parallel --stream run dev",
        "typecheck": "pnpm -r exec tsc --noEmit",
        "build:cli": "pnpm --filter @pi-tray/cli package",
        "build:app": "pnpm --filter @pi-tray/editor tauri build && node scripts/collect-app.mjs",
        "set-version": "node scripts/set-version.mjs"
    },
    "devDependencies": {
        "@yao-pkg/pkg": "^6.23.0",
        "minimist": "catalog:",
        "pe-library": "^1.0.1",
        "resedit": "^2.0.3",
        "tar": "^7.4.3"
    },
    "packageManager": "pnpm@10.28.0",
    "engines": {
        "node": ">=22"
    }
}
